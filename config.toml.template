# =============================================================================
#  gke-postgresql-statefulset 設定ファイル
# =============================================================================
#  使い方:
#      cp config.toml.template config.toml   (または `make config`)
#      vi config.toml
#      make db
#
#  ここに書かれている値がそのままデフォルト値です。
#  config.toml では変更したいキーだけを書けば足ります（未記載のキーは
#  このファイルの値が使われます）。
#
#  環境変数による一時的な上書きも可能です。キー名は CFG_<セクション>_<キー>:
#      CFG_POSTGRES_REPLICAS=3 CFG_CLUSTER_NUM_NODES=5 make db
# =============================================================================


# -----------------------------------------------------------------------------
# [gcp] Google Cloud プロジェクトと既定のロケーション
# -----------------------------------------------------------------------------
[gcp]
# 空文字の場合は `gcloud config get-value project` の値を使用します。
project = ""

# リージョン。Autopilot クラスタ、および cluster.location_type = "regional" の
# Standard クラスタの配置先。
region = "asia-northeast1"

# ゾーン。cluster.location_type = "zonal" の Standard クラスタの配置先。
zone = "asia-northeast1-a"


# -----------------------------------------------------------------------------
# [cluster] GKE クラスタ (存在しなければ `make db` 実行時に自動作成)
# -----------------------------------------------------------------------------
[cluster]
name = "pg-cluster"

# クラスタの種類
#   "autopilot" … ノードを GKE に任せる Autopilot クラスタ。Pod の要求に応じて
#                 ノードが自動で用意されます。Autopilot は常にリージョナルで、
#                 gcp.region に作成されます（location_type は使われません）。
#   "standard"  … ノードプールを自分で持つ従来のクラスタ。
mode = "autopilot"

# ---- 共通の属性 ----
# rapid | regular | stable | extended | None
# ("None" にして特定バージョンを固定できるのは mode = "standard" のときだけです)
release_channel = "regular"

# 空ならリリースチャンネルの既定バージョン。例: "1.33.4-gke.1036000"
cluster_version = ""

# Spot を使ってコストを下げる（検証用途向け。突然停止し得ます）
#   mode = "autopilot" … PostgreSQL の Pod を Spot Pod として起動する
#                        (nodeSelector: cloud.google.com/gke-spot=true)
#   mode = "standard"  … ノードプールを Spot VM で作成する
spot = false

# `gcloud container clusters create` / `create-auto` にそのまま渡す追加フラグ
# （上級者向け。空白区切り）
extra_create_args = ""


# ---- ここから下は mode = "standard" のときだけ使われます ----

# "zonal"   … gcp.zone に単一ゾーンで作成（安価・検証向け）
# "regional" … gcp.region に 3 ゾーン構成で作成（num_nodes は「ゾーンあたり」の台数）
location_type = "zonal"

# ---- ノードのサイズ（任意に指定可能） ----
machine_type = "e2-standard-4"
num_nodes = 3
disk_type = "pd-balanced"      # pd-standard | pd-balanced | pd-ssd
disk_size_gb = 100

# ノードプールのオートスケール。enable = false なら num_nodes 固定。
autoscaling = false
min_nodes = 1
max_nodes = 6

# ノードのイメージ。COS_CONTAINERD 推奨。
image_type = "COS_CONTAINERD"

# Workload Identity を有効化する（Autopilot では常に有効です）
workload_identity = true


# -----------------------------------------------------------------------------
# [postgres] StatefulSet として作る PostgreSQL 本体
# -----------------------------------------------------------------------------
[postgres]
namespace = "database"
name = "postgres"

# postgres 公式イメージのタグ
version = "17"

# レプリカ数。1 なら単体構成。2 以上ならストリーミングレプリケーション構成
# （ordinal 0 がプライマリ、1 以降が pg_basebackup で複製されるスタンバイ）。
replicas = 1

# ---- ストレージのサイズ（任意に指定可能） ----
storage_size = "20Gi"
# GKE 標準の StorageClass: standard-rwo (Balanced PD) | premium-rwo (SSD PD)
storage_class = "premium-rwo"

# ---- Pod のリソース（任意に指定可能） ----
cpu_request = "500m"
cpu_limit = "2"
memory_request = "1Gi"
memory_limit = "4Gi"

# ---- 初期作成されるデータベースとユーザ ----
database = "appdb"
user = "app"
# 空の場合は自動生成し .secrets/postgres_password に保存します。
# （クラスタ上に Secret が既にある場合はそちらの値が再利用されます）
password = ""

# レプリケーション用ロール（replicas >= 2 のときに使用）
replication_user = "replicator"
replication_password = ""

# ---- postgresql.conf のチューニング ----
shared_buffers = "256MB"
effective_cache_size = "1GB"
maintenance_work_mem = "128MB"
work_mem = "8MB"
max_connections = 100
wal_level = "replica"
max_wal_senders = 10
max_replication_slots = 10
log_min_duration_statement = 1000

# postgres 起動時に追加で渡す -c パラメータ（空白区切り、例: "log_statement=all")
extra_pg_params = ""

# ---- 公開方法 ----
# true にすると内部 LoadBalancer (VPC 内からのみ到達可能) を追加で作成します。
internal_lb = false


# -----------------------------------------------------------------------------
# [content] `make db-content` で投入するスキーマ / ダミーデータ
# -----------------------------------------------------------------------------
[content]
# pg_dump 形式 (plain text) のファイル。make db-content はこれを psql で流し込みます。
dump_file = "sql/dump.sql"

# `make gen-dump` でダミーデータを再生成するときの行数
rows_customers = 2000
rows_products = 500
rows_orders = 8000

# 乱数シード（同じ値なら毎回同じダミーデータが生成されます）
seed = 20260901


# -----------------------------------------------------------------------------
# [alloydb] AlloyDB クラスタ (最小構成) と Private Service Connect
#           `make alloydb` で作成します。PSC エンドポイントは GKE クラスタと同じ
#           VPC に作るので、GKE 上の Pod から内部 IP で到達できます。
# -----------------------------------------------------------------------------
[alloydb]
cluster = "alloydb"
instance = "alloydb-primary"

# 空なら gcp.region。PSC エンドポイント (予約 IP と転送ルール) もこのリージョンに作られます。
region = ""

# POSTGRES_14 | POSTGRES_15 | POSTGRES_16 | POSTGRES_17 | POSTGRES_18
database_version = "POSTGRES_17"

# ---- インスタンスのサイズ (最小構成) ----
# machine_type が空なら N2 (n2-highmem-<cpu_count>)。cpu_count は 2/4/8/16/32/64/96/128。
# C4A 対応リージョン (us-central1 など) では machine_type = "c4a-highmem-1" と
# cpu_count = 1 の組み合わせが最小です (開発・検証用途向け)。
machine_type = ""
cpu_count = 2

# "ZONAL" (単一ノード・安価) | "REGIONAL" (HA。スタンバイノードあり)
availability_type = "ZONAL"

# ---- 初期作成されるデータベースとユーザ (StatefulSet 側と同じ名前にしてあります) ----
database = "appdb"
user = "app"
# 空なら自動生成し .secrets/alloydb_app_password に保存します。
# (postgres ユーザのパスワードは常に自動生成され .secrets/alloydb_superuser_password に保存されます)
password = ""

# ---- マネージド接続プーリング (Managed Connection Pooling) ----
# true にするとインスタンス上でプーラーが動き、ポート 6432 で待ち受けます。
# (AlloyDB の既定は無効。5432 は有効にしても従来どおり直結のまま使えます)
#
# サンプルアプリは connection_pooling = true のとき 6432 に接続します。
# 一方 make alloydb-psql / make alloydb-content は常に 5432 に直結します
# (transaction モードでは SET などが使えず、dump の投入に失敗するため)。
# プーラー経由で確認したいときは POOLED=1 make alloydb-psql を使ってください。
connection_pooling = true

# プーリングのモード。connection_pooling = true のときだけ使われます。
#   "transaction" … トランザクション単位でサーバ接続を貸し出す (既定。多重化の効果が高い)
#                    SET / LISTEN / PREPARE / セッションレベルの advisory lock、
#                    プロトコルレベルの prepared statement は使えません
#   "session"     … 切断まで同じサーバ接続を割り当てる (制約は少ないが多重化の効果も小さい)
# ("TRANSACTION" のような大文字で書いても構いません。gcloud に渡すときに変換します)
pool_mode = "transaction"

# プールサイズなどの詳細は extra_instance_args に
# --connection-pooling-max-pool-size=100 のように書いて渡してください。

# ---- PSC エンドポイント ----
# 予約する内部 IP アドレスと転送ルールの名前 (両方に同じ名前を使います)
psc_endpoint = "alloydb-psc"
# 空ならサブネットから自動で割り当てます。固定したい場合はサブネット内の IP を指定します。
psc_ip = ""

# `gcloud alloydb clusters create` / `instances create` にそのまま渡す追加フラグ
# (上級者向け。空白区切り)
extra_cluster_args = ""
extra_instance_args = ""


# -----------------------------------------------------------------------------
# [app] app/ のサンプル Web アプリ (`make app` で GKE にデプロイ)
# -----------------------------------------------------------------------------
[app]
# 接続先。切り替えたら `make app` (または `make app-target T=alloydb`) で再デプロイします。
#   "postgresql" … この Makefile で作った StatefulSet (postgres-rw Service)
#   "alloydb"    … PSC エンドポイント経由の AlloyDB
target = "postgresql"

namespace = "app"
name = "sample-app"
replicas = 1

# コンテナイメージのビルド方法
#   "cloudbuild" … Cloud Build でビルドして Artifact Registry に push (手元に docker 不要)
#   "docker"     … 手元の docker でビルドして push
builder = "cloudbuild"

# Artifact Registry の Docker リポジトリ名 (gcp.region に無ければ作成します)
registry = "gke-postgresql-statefulset"

# イメージのタグ。空なら app/ の内容のハッシュを使い、内容が変わっていなければ
# ビルドをスキップします。
image_tag = ""

# "ClusterIP" (make app-port-forward で閲覧) | "LoadBalancer" (外部 IP を付与して公開)
service_type = "ClusterIP"

# Pod のリソース (Autopilot ではこの要求値が課金対象)
cpu_request = "250m"
memory_request = "512Mi"
