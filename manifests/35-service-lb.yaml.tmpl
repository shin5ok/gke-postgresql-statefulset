# 内部 LoadBalancer。同じ VPC 内 (別クラスタや GCE VM) からのみ到達可能。
# postgres.internal_lb = true のときだけ作成される。
apiVersion: v1
kind: Service
metadata:
  name: ${CFG_POSTGRES_NAME}-lb
  namespace: ${CFG_POSTGRES_NAMESPACE}
  labels:
    app: ${CFG_POSTGRES_NAME}
    app.kubernetes.io/name: postgresql
    app.kubernetes.io/instance: ${CFG_POSTGRES_NAME}
    app.kubernetes.io/managed-by: gke-postgresql-statefulset
  annotations:
    networking.gke.io/load-balancer-type: "Internal"
spec:
  type: LoadBalancer
  externalTrafficPolicy: Local
  selector:
    app: ${CFG_POSTGRES_NAME}
    statefulset.kubernetes.io/pod-name: ${CFG_POSTGRES_NAME}-0
  ports:
    - name: postgresql
      port: 5432
      targetPort: postgresql
