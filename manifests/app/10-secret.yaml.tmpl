# アプリが使う DB パスワード。deploy-app.sh が接続先 (StatefulSet / AlloyDB) に応じて解決する。
apiVersion: v1
kind: Secret
metadata:
  name: ${CFG_APP_NAME}-db
  namespace: ${CFG_APP_NAMESPACE}
  labels:
    app: ${CFG_APP_NAME}
    app.kubernetes.io/name: sample-app
    app.kubernetes.io/managed-by: gke-postgresql-statefulset
type: Opaque
data:
  DB_PASSWORD: ${CFG_APP_DB_PASSWORD_B64}
